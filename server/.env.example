# Server Environment Variables
# Copy this file to .env and fill in your values

# ────────────────────────────────────────────────
# Server
# ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ────────────────────────────────────────────────
# MongoDB Atlas
# ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerpilot?retryWrites=true&w=majority
# Optional app-process DNS override when the system resolver cannot resolve Atlas SRV records.
# Leave empty normally; this does not change Windows network settings.
DNS_SERVERS=

# ────────────────────────────────────────────────
# JWT
# ────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
COOKIE_SAME_SITE=strict
# Required for production. Read DEPLOYMENT.md before changing these confirmations.
SERVICE_OPERATOR=
SUPPORT_EMAIL=
AI_DATA_POLICY_ACKNOWLEDGED=false
GEMINI_BILLING_VERIFIED=false
CRON_SECRET=
MAX_RESUMES_PER_USER=20
UPLOAD_REQUEST_LIMIT=10
AI_DAILY_LIMIT=30
AI_MAX_CONCURRENT=4
AI_OPERATION_TIMEOUT_MS=180000

# Password-reset email. "console" prints the local reset URL without sending
# mail. Use "resend" with a verified sender for deployed environments.
EMAIL_PROVIDER=console
EMAIL_FROM=CareerPilot <onboarding@resend.dev>
RESEND_API_KEY=
PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# ────────────────────────────────────────────────
# Cloudinary (https://cloudinary.com — free tier)
# ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ────────────────────────────────────────────────
# AI provider
# Use "fallback" for Gemini -> Groq -> Ollama automatic failover, or select one provider directly.
# ────────────────────────────────────────────────
AI_PROVIDER=gemini
AI_FALLBACK_COOLDOWN_MS=60000
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TIMEOUT_MS=45000

# Required only when AI_PROVIDER=groq. Keep this server-side and never commit it.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=90000

# Required only when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=120000
